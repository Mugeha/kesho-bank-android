    <string name="roe_title">Rules of Engagement</string>
    <string name="roe_body">Kesho Bank is an official Africahackon practice platform. It is a wholly fictional mobile banking app created for authorized security-testing practice. It is not a real bank or financial institution, and it contains no real customer, account, or transaction data. Every record is synthetic.</string>
    <string name="roe_scope_heading">Who may test, and what\'s in scope</string>
    <string name="roe_scope_body">Testing is permitted only for registered Africahackon community members, against your own local instance of this app and its optional backend. Any vulnerability class you can genuinely trigger against Kesho Bank\'s own functionality is in scope.</string>
    <string name="roe_out_of_scope_heading">Out of scope</string>
    <string name="roe_out_of_scope_body">Any app or service other than Kesho Bank itself; denial-of-service or availability testing; real personal data of any kind; anything other than your own local, self-hosted instance. There is no shared or hosted Kesho Bank instance.</string>
    <string name="roe_contact">Questions about scope, or an issue with the environment: academy@africahackon.com</string>
    <string name="roe_acknowledge">I understand, continue</string>

